# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/secrets.toml   # never commit API keys / HF tokens

# ── HuggingFace / model weights ───────────────────────────────────────────────
# Downloaded model weights & tokeniser caches are huge — don't commit them
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.ggml
tokenizer/
adapter/
hf_cache/
.cache/

# ── Jupyter / Kaggle artefacts ────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Generated data / run outputs ──────────────────────────────────────────────
*.jsonl
*.json
!package.json           # keep package.json if ever added
split_manifest.jsonl
synthetic_*.jsonl
*_bundle.zip
*.zip
run_*/                  # Kaggle run directories (insuranceqa_*, bitext_*)
insuranceqa_*/
bitext_*/
reports/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/
wandb/

# ── OS clutter ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

